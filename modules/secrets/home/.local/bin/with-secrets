#!/usr/bin/env bash
# with-secrets NAME... -- <command>: run a command with only the named secrets as env vars; values never reach the terminal.
# with-secrets --list: the secret names. sops leaves YAML keys unencrypted, so listing decrypts nothing.
set -euo pipefail
export SOPS_AGE_KEY_FILE="$HOME/.secrets/age.key"
file="$HOME/.secrets/secrets.yaml"
if [ "${1:-}" = --list ]; then
  awk -F: '/^[A-Za-z0-9_]+:/ && $1 != "sops" { print $1 }' "$file"
  exit 0
fi
names=()
while [ $# -gt 0 ] && [ "$1" != "--" ]; do
  names+=("$1")
  shift
done
if [ $# -eq 0 ] || [ ${#names[@]} -eq 0 ]; then
  echo "usage: with-secrets NAME... -- <command> | with-secrets --list" >&2
  exit 2
fi
shift
for name in "${names[@]}"; do
  value="$(sops -d --extract "[\"$name\"]" "$file" 2>/dev/null)" || {
    echo "with-secrets: no secret named $name" >&2
    exit 1
  }
  export "$name=$value"
done
exec bash -c "$*"
