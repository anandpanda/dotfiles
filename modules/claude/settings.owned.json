{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Read(~/.secrets/**)",
      "Edit(~/.secrets/**)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env.*)",
      "Read(~/.ssh/id_*)",
      "Edit(~/.ssh/id_*)",
      "Read(~/.aws/sso/cache/**)",
      "Edit(~/.aws/sso/cache/**)",
      "Edit(~/.claude/settings.json)",
      "Bash(sops -d *)",
      "Bash(sops decrypt *)",
      "Bash(sops --decrypt *)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh workflow run *)",
      "Bash(gh run rerun *)",
      "Bash(gh run cancel *)",
      "Bash(gh api *-X POST*)",
      "Bash(gh api *-X PATCH*)",
      "Bash(gh api *-X PUT*)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *--method POST*)",
      "Bash(gh api *--method PATCH*)",
      "Bash(gh api *--method PUT*)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *-f *)",
      "Bash(gh api *-F *)",
      "Bash(gh api *--field *)",
      "Bash(gh api *--raw-field *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push * master)",
      "Bash(git push * master *)",
      "Bash(git push *:master)",
      "Bash(git push *:master *)",
      "Bash(git push * develop)",
      "Bash(git push * develop *)",
      "Bash(git push *:develop)",
      "Bash(git push *:develop *)",
      "Bash(git push * release*)",
      "Bash(git push * release* *)",
      "Bash(git push *:release*)",
      "Bash(git push *:release* *)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(docker system prune*)",
      "Bash(docker volume rm *)",
      "mcp__*-set-*",
      "mcp__*_deploy",
      "mcp__*_deploy_*",
      "mcp__*_edit_*",
      "mcp__*_label_*",
      "mcp__*_set_*",
      "mcp__*accept*",
      "mcp__*add*",
      "mcp__*approve*",
      "mcp__*assign*",
      "mcp__*buy*",
      "mcp__*cancel*",
      "mcp__*comment",
      "mcp__*comment_*",
      "mcp__*create*",
      "mcp__*delete*",
      "mcp__*invite*",
      "mcp__*kill*",
      "mcp__*mark*",
      "mcp__*merge*",
      "mcp__*move*",
      "mcp__*pause*",
      "mcp__*post*",
      "mcp__*promote*",
      "mcp__*publish*",
      "mcp__*remove*",
      "mcp__*reply*",
      "mcp__*rerequest*",
      "mcp__*resolve*",
      "mcp__*respond*",
      "mcp__*restore*",
      "mcp__*review*",
      "mcp__*rollback*",
      "mcp__*run_session*",
      "mcp__*save*",
      "mcp__*schedule*",
      "mcp__*send*",
      "mcp__*share_*",
      "mcp__*stop*",
      "mcp__*submit*",
      "mcp__*transfer*",
      "mcp__*trash*",
      "mcp__*update*",
      "mcp__*upload*",
      "mcp__*write*"
    ]
  },
  "attribution": {"commit": "", "pr": "", "sessionUrl": false},
  "cleanupPeriodDays": 365,
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": false
  },
  "env": {
    "SECURITY_REVIEW_MODEL": "claude-sonnet-5-5"
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.sh"
  }
}
