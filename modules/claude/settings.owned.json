{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Read(~/.secrets/**)",
      "Edit(~/.secrets/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/id_*)",
      "Read(~/.aws/sso/cache/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/hooks/**)"
    ],
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(ls *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)"
    ]
  },
  "attribution": false,
  "cleanupPeriodDays": 365,
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  }
}
