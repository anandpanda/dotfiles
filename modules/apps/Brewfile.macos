# Desktop apps. All free. Work-managed apps (JumpCloud, Falcon, VPN, Slack, Zoom) are IT's and not here.
# Third-party taps: Homebrew 7 loads nothing from them until trusted; trust the one item, not the tap.
tap "nikitabobko/tap"
tap "menubar-apps/menubar-apps"

# Launcher, clipboard history, snippets (replaces Spotlight, Maccy)
cask "raycast"
# Tiling window manager: alt-hjkl focus, alt-1..9 workspaces (config in modules/aerospace)
cask "nikitabobko/tap/aerospace", trusted: true
# Caps Lock -> Escape (tap) / Hyper (hold) (config in modules/karabiner)
cask "karabiner-elements"
# Screenshots: annotate, OCR, measure. Cmd-Shift-2
cask "shottr"
# Menu bar: hide the clutter
cask "jordanbaird-ice"
# CPU, memory, network in the menu bar
cask "stats"
# Cmd-Tab with per-window previews
cask "alt-tab"
# Browsers: Brave (default) and Chrome (test target) update themselves through Google's
# updater, which locks their bundles so Homebrew cannot adopt or replace them. They stay
# hand-installed; the checklist covers a fresh machine.
# Quick todo list in the menu bar
cask "menubar-apps/menubar-apps/todobar", trusted: true
# Archives, full uninstalls, external monitor brightness
cask "keka"
cask "appcleaner"
cask "monitorcontrol"
# Notes, if ever wanted (markdown on disk, free)
# cask "obsidian"
